# QuantDesk — environment variables
# Copy to .env.local and fill in values.

# --- Alpaca Markets (intraday bars + live quotes for auto-trading) ---
# Free account at https://app.alpaca.markets/signup — no credit card required.
# Paper-trading key pair (do NOT use live-trading keys here - paper-only!).
# Required for: intraday bar ingest, automated paper-trade entries, live quotes.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# --- Automated intraday paper-trading ---
# Set AUTO_TRADE_ENABLED=1 to activate the intraday cron.
# STRONGLY RECOMMENDED: start with DRY_RUN=1 to see what it would trade via Telegram
# before enabling live paper entries.
#
# AUTO_TRADE_ENABLED=0        # 0 = disabled (default), 1 = enabled
# AUTO_TRADE_DRY_RUN=1        # 1 = compute + Telegram only, no DB writes (default)
# AUTO_TRADE_TIMEFRAME=15m    # intraday bar timeframe: 1m, 5m, 15m, 1h
# AUTO_TRADE_CRON=*/15 9-16 * * 1-5  # every 15 min during US RTH (America/New_York)
# AUTO_TRADE_MIN_CONSENSUS=2  # min strategies that must agree for an entry
# AUTO_TRADE_MAX_TRADES_PER_DAY=5   # max new auto-trades per calendar day
# AUTO_TRADE_DAILY_LOSS_HALT_PCT=0.02  # halt if day P&L < -2% of equity (production default)

# --- Phase 2: Data providers ---
# Yahoo Finance (yahoo-finance2) — no key needed, unofficial API
# YAHOO_FINANCE_ENABLED=true

# Twelve Data — free tier: 800 req/day, 8 req/min. Sign up at twelvedata.com
# Covers US + global equities, forex, crypto, indices. India: TCS:NSE notation.
TWELVE_DATA_API_KEY=

# Polygon.io — paid tier (future)
# POLYGON_API_KEY=

# Alpha Vantage — free tier: 25 req/day (future)
# ALPHA_VANTAGE_API_KEY=

# Dhan (India equities) — future adapter
# DHAN_API_KEY=
# DHAN_CLIENT_ID=

# Metals API — gold/commodities (future)
# METALS_API_KEY=

# --- Phase 2: Scheduling ---
# EOD refresh cron (default: 21:05 Europe/Dublin = ~16:05 ET)
# REFRESH_CRON=5 21 * * 1-5
# REFRESH_TZ=Europe/Dublin

# --- Telegram alerts (stop/target proximity monitor) ---
# 1. Create a bot: message @BotFather on Telegram, /newbot, copy the token.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
# Both must be set or the monitor stays idle (no errors, just no alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- TradingView MCP drawing integration ---
# QD_TV_DRAW=1
# QD_TV_CLI=/path/to/tradingview-mcp/src/cli/index.js
# QD_TV_CLEAR=1   # optional: wipe old drawings before each trade

# Alert when price is within this % of a stop/target level (default 2).
# ALERT_PROXIMITY_PCT=2

# Monitor cadence - default every 15 min, Mon-Fri.
# MONITOR_CRON=*/15 * * * 1-5

# --- Swing constraints ---
# Force-exit any position (backtest, compare, edge stats, paper sweep) after
# this many trading bars. Default 21 (~1 month).
# MAX_HOLD_BARS=21

# --- Paper account FX (account currency is USD) ---
# Static approximate rates for converting non-USD trades into the USD budget.
# FX_INR_USD=0.012
# FX_EUR_USD=1.08
# FX_GBP_USD=1.27

# --- TradingView auto-open ---
# Set to '1' to open the TradingView chart in your browser when a paper trade is placed.
# macOS only (uses `open` command).
# QD_TRADINGVIEW_AUTOOPEN=1

# --- SQLite database path ---
# Default: <cwd>/data/quantdesk.db. Override to point to a separate EBS volume on EC2.
# DB_PATH=/mnt/data/quantdesk.db

# --- Risk management (enforced on every paper trade when a budget is set) ---
# Max entry cost of one position, % of equity (one trade must not sink the account).
# RISK_MAX_POSITION_PCT=25
# Max combined stop-loss risk across open trades, % of equity (stop-less trades count at full cost).
# RISK_MAX_OPEN_RISK_PCT=6
# Max simultaneously open paper trades (production: 4 - SP500 MR strategies correlate in drawdown).
# RISK_MAX_OPEN_TRADES=4
# Halt all new entries when equity falls this % below starting budget (production: 12%).
# OOS walk-forward max DD for active MR strategies is ~8-10%; 12% = 1.5x OOS max DD.
# Requires manually resetting the budget to lift - not auto-resuming.
# RISK_HALT_DRAWDOWN_PCT=12
