# QuantDesk — environment variables
# Copy to .env.local and fill in values.

# --- Alpaca Markets (intraday bars + live quotes for auto-trading) ---
# Free account at https://app.alpaca.markets/signup — no credit card required.
# Paper-trading key pair (do NOT use live-trading keys here - paper-only!).
# Required for: intraday bar ingest, automated paper-trade entries, live quotes.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# --- Automated intraday paper-trading ---
# Set AUTO_TRADE_ENABLED=1 to activate the intraday cron.
# STRONGLY RECOMMENDED: start with DRY_RUN=1 to see what it would trade via Telegram
# before enabling live paper entries.
#
# AUTO_TRADE_ENABLED=0        # 0 = disabled (default), 1 = enabled
# AUTO_TRADE_DRY_RUN=1        # 1 = compute + Telegram only, no DB writes (default)
# AUTO_TRADE_TIMEFRAME=15m    # intraday bar timeframe: 1m, 5m, 15m, 1h
# AUTO_TRADE_CRON=*/15 9-16 * * 1-5  # every 15 min during US RTH (America/New_York)
# AUTO_TRADE_MIN_CONSENSUS=2  # min strategies that must agree for an entry
# AUTO_TRADE_MAX_TRADES_PER_DAY=5   # max new auto-trades per calendar day
# AUTO_TRADE_DAILY_LOSS_HALT_PCT=0.02  # halt if day P&L < -2% of equity (production default)

# --- Phase 2: Data providers ---
# Yahoo Finance (yahoo-finance2) — no key needed, unofficial API
# YAHOO_FINANCE_ENABLED=true

# Twelve Data — free tier: 800 req/day, 8 req/min. Sign up at twelvedata.com
# Covers US + global equities, forex, crypto, indices. India: TCS:NSE notation.
TWELVE_DATA_API_KEY=

# Polygon.io — paid tier (future)
# POLYGON_API_KEY=

# Alpha Vantage — free tier: 25 req/day (future)
# ALPHA_VANTAGE_API_KEY=

# Dhan (India equities) — future adapter
# DHAN_API_KEY=
# DHAN_CLIENT_ID=

# Metals API — gold/commodities (future)
# METALS_API_KEY=

# --- Multi-market daily scan scheduling (all times Europe/Dublin) ---
# NSE scan after NSE close (15:30 IST = 11:00 Dublin summer / 10:30 winter; 11:30 safe both seasons)
# NSE_SCAN_CRON=30 11 * * 1-5
# EU scan after continental close (~16:30 UTC; 16:45 Dublin year-round)
# EU_SCAN_CRON=45 16 * * 1-5
# US + commodities scan (default: 21:05 Dublin = ~16:05 ET)
# REFRESH_CRON=5 21 * * 1-5
# REFRESH_TZ=Europe/Dublin

# --- Daily paper-trade execution (NSE / EU / US daily bars) ---
# Separate from the intraday US auto-trade (AUTO_TRADE_ENABLED above).
# STRONGLY RECOMMENDED: start with DAILY_AUTO_TRADE_DRY_RUN=1, watch a few days
# of [INTENDED] alerts, then flip DAILY_AUTO_TRADE_DRY_RUN=0 to open real paper
# trades on all three daily markets (NSE/EU/SP500) - not just intraday US.
# DAILY_AUTO_TRADE_ENABLED=0        # 0 = disabled (default), 1 = enabled
# DAILY_AUTO_TRADE_DRY_RUN=1        # 1 = Telegram-only, no DB writes; 0 = real paper trades
# DAILY_AUTO_TRADE_MIN_CONSENSUS=2  # strategies that must agree
# DAILY_AUTO_TRADE_MAX_TRADES_PER_DAY=3   # max new trades per calendar day per market
# DAILY_AUTO_TRADE_DAILY_LOSS_HALT_PCT=0.03  # halt at -3% equity loss

# --- Telegram alerts (stop/target proximity monitor) ---
# 1. Create a bot: message @BotFather on Telegram, /newbot, copy the token.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
# Both must be set or the monitor stays idle (no errors, just no alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- TradingView MCP drawing integration ---
# QD_TV_DRAW=1
# QD_TV_CLI=/path/to/tradingview-mcp/src/cli/index.js
# QD_TV_CLEAR=1   # optional: wipe old drawings before each trade

# Alert when price is within this % of a stop/target level (default 2).
# ALERT_PROXIMITY_PCT=2

# Monitor cadence - default every 15 min, Mon-Fri.
# MONITOR_CRON=*/15 * * * 1-5

# --- Swing constraints ---
# Force-exit any position (backtest, compare, edge stats, paper sweep) after
# this many trading bars. Default 21 (~1 month).
# MAX_HOLD_BARS=21

# --- Paper account FX (account currency is USD) ---
# Static approximate rates for converting non-USD trades into the USD budget.
# FX_INR_USD=0.012
# FX_EUR_USD=1.08
# FX_GBP_USD=1.27

# --- TradingView auto-open ---
# Set to '1' to open the TradingView chart in your browser when a paper trade is placed.
# macOS only (uses `open` command).
# QD_TRADINGVIEW_AUTOOPEN=1

# --- Database (Turso / libSQL embedded replica) ---
# One shared DB for local dev + prod EC2 (both point here). Free tier: 5GB storage,
# 500M row reads/mo, never expires, no card. Get URL + token from `turso db show` / `turso db tokens create`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional: seconds between background replica syncs. Unset = sync only via explicit db.sync() on connect.
# TURSO_SYNC_PERIOD=60

# --- Local SQLite path ---
# If TURSO_DATABASE_URL is set, this is the LOCAL REPLICA CACHE FILE (not the source
# of truth) - safe to delete, it gets rebuilt from Turso on next connect.
# If TURSO_DATABASE_URL is unset, this is a plain standalone SQLite file (no Turso needed).
# Default: <cwd>/data/quantdesk.db. Override to point to a separate EBS volume on EC2.
# DB_PATH=/mnt/data/quantdesk.db

# --- Local-dev safety switch ---
# Recommended default for local dev once pointed at the shared Turso DB above.
# Disables ALL cron registration (NSE/EU/US scans, intraday auto-trade, the stop/target
# monitor) at server boot, and forces telegramConfigured() to return false as a second guard.
# Does NOT block manual actions - clicking TRIGGER NOW / OPEN TRADE in the UI, or hitting
# the API directly, still write to the shared remote DB in embedded-replica mode. Be
# deliberate about what you test locally.
LOCAL_DEV_MODE=1

# --- Risk management (enforced on every paper trade when a budget is set) ---
# Max entry cost of one position, % of equity (one trade must not sink the account).
# RISK_MAX_POSITION_PCT=25
# Max combined stop-loss risk across open trades, % of equity (stop-less trades count at full cost).
# RISK_MAX_OPEN_RISK_PCT=6
# Global ceiling: max simultaneously open trades across ALL markets.
# Default raised to 16 for multi-market use (4 markets x 4 each).
# Set to 4 to revert to single-market behaviour.
# RISK_MAX_OPEN_TRADES=16
# Per-market cap: max open trades from the same market (nse/eu/sp500/commodity).
# Only applied when a trade carries a market tag. Default 4.
# RISK_MAX_OPEN_TRADES_PER_MARKET=4
# Halt all new entries when equity falls this % below starting budget (production: 12%).
# OOS walk-forward max DD for active MR strategies is ~8-10%; 12% = 1.5x OOS max DD.
# Requires manually resetting the budget to lift - not auto-resuming.
# RISK_HALT_DRAWDOWN_PCT=12
# Fraction of equity risked on each new trade for position sizing. Default 0.01 (1%).
# Raising this (with RISK_MAX_OPEN_RISK_PCT) deploys more capital per position -
# fewer, larger positions instead of many tiny ones. Moderate: 0.015 (1.5%).
# RISK_PER_TRADE_PCT=0.015

# --- Capital rotation (off by default) ---
# When the book is full (risk ceiling / trade cap / cash exhausted) and a new
# signal has strictly higher conviction (more strategies agreeing) than the
# weakest open holding, close that holding to make room for the new trade.
# Off by default - opt in once you're comfortable with normal auto-trade behavior.
# ROTATION_ENABLED=1
# Minimum days a position must be held before it's eligible to be rotated out
# (avoids churning positions that just opened). Default 3.
# ROTATION_MIN_HOLD_BARS=3
# Max rotations per market per calendar day. Default 2.
# ROTATION_MAX_PER_DAY=2
