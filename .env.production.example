# QuantDesk — production env vars for EC2
# Copy to .env and fill in values before running deploy.sh

# --- Required: Alpaca (intraday data + auto-trade) ---
ALPACA_KEY_ID=PK...
ALPACA_SECRET_KEY=...

# --- Required: Telegram alerts ---
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# --- Auto-trade ---
AUTO_TRADE_ENABLED=1
AUTO_TRADE_DRY_RUN=0         # set to 1 first to verify, then flip to 0
AUTO_TRADE_TIMEFRAME=15m
AUTO_TRADE_MIN_CONSENSUS=2
AUTO_TRADE_MAX_TRADES_PER_DAY=5
AUTO_TRADE_DAILY_LOSS_HALT_PCT=0.03

# --- TradingView (optional, Mac-only - disable on EC2) ---
# QD_TRADINGVIEW_AUTOOPEN=0

# --- Optional: Twelve Data (EOD fallback) ---
# TWELVE_DATA_API_KEY=
